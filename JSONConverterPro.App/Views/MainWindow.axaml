<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:JSONConverterPro.ViewModels"
        xmlns:m="using:JSONConverterPro.Models"
        xmlns:core="using:JSONConverterPro.Core.Models"
        xmlns:conv="using:JSONConverterPro.Converters"
        x:Class="JSONConverterPro.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="JSON Converter Pro" Width="1180" Height="780" MinWidth="900" MinHeight="620"
        Icon="avares://JSONConverterPro/Resources/AppIcon.png"
        WindowStartupLocation="CenterScreen">

  <Grid RowDefinitions="Auto,Auto,*">

    <!-- Top bar -->
    <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="20,10">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Image Source="avares://JSONConverterPro/Resources/AppIcon.png" Width="32" Height="32" />
          <TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold">
            <Run Text="JSON Converter " /><Run Text="Pro" Foreground="{DynamicResource AccentBrush}" />
          </TextBlock>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="28,0,0,0" VerticalAlignment="Center">
          <Button Classes="tab" Classes.active="{Binding IsConvertPage}" Command="{Binding NavigateCommand}" CommandParameter="Convert" Content="Convert" />
          <Button Classes="tab" Classes.active="{Binding IsFilesPage}" Command="{Binding NavigateCommand}" CommandParameter="Files" Content="Files" />
          <Button Classes="tab" Classes.active="{Binding IsSettingsPage}" Command="{Binding NavigateCommand}" CommandParameter="Settings" Content="Settings" />
          <Button Classes="tab" Classes.active="{Binding IsHistoryPage}" Command="{Binding NavigateCommand}" CommandParameter="History" Content="History" />
          <Button Classes="tab" Classes.active="{Binding IsLogPage}" Command="{Binding NavigateCommand}" CommandParameter="Log" Content="Error log" />
        </StackPanel>
        <TextBlock Grid.Column="2" Text="{Binding Version}" Classes="muted" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <!-- Banner -->
    <Border x:Name="BannerBorder" Classes="banner" Grid.Row="1" IsVisible="{Binding ShowBanner}" Margin="24,14,24,0" Padding="16,10" CornerRadius="12" BorderThickness="1">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Text="{Binding BannerText}" TextWrapping="Wrap" VerticalAlignment="Center" FontWeight="Medium" />
        <Button Grid.Column="1" Classes="soft" Content="Open folder" Command="{Binding OpenOutputFolderCommand}" IsVisible="{Binding BannerHasFolder}" Margin="12,0,0,0" />
        <Button Grid.Column="2" Classes="icon" Content="✕" AutomationProperties.Name="Dismiss message" ToolTip.Tip="Dismiss" Command="{Binding DismissBannerCommand}" Margin="6,0,0,0" />
      </Grid>
    </Border>

    <!-- Pages -->
    <Grid Grid.Row="2">

      <!-- ===== Convert page: paste, live preview, download ===== -->
      <Grid IsVisible="{Binding IsConvertPage}" Margin="24,16,24,16" RowDefinitions="*,Auto,2*,Auto">

        <Border x:Name="EditorCard" Grid.Row="0" Classes="card" Padding="0" MinHeight="120">
          <Grid RowDefinitions="Auto,*">
            <Grid ColumnDefinitions="*,Auto" Margin="14,8,10,0">
              <TextBlock Text="Paste or type JSON here" Classes="muted" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                <Button Classes="icon" Content="Format" Command="{Binding FormatPasteCommand}" ToolTip.Tip="Pretty-print the JSON" />
                <Button Classes="icon" Content="Clear" Command="{Binding ClearPasteCommand}" />
              </StackPanel>
            </Grid>
            <TextBox x:Name="PasteBox" AutomationProperties.Name="JSON text to convert" Grid.Row="1" Text="{Binding PasteText}" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                     Watermark='{}{ "paste": "your JSON here" }   (Ctrl+V or ⌘+V)'
                     FontFamily="Menlo,Consolas,Courier New,monospace" FontSize="12" BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" Padding="14,4" />
          </Grid>
        </Border>

        <!-- Status row -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="0,10,0,10">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Border Classes="badge" Classes.ok="{Binding PasteIsOk}" Classes.err="{Binding PasteIsError}" Classes.warn="{Binding PasteIsWarn}" VerticalAlignment="Center">
              <TextBlock Text="{Binding PasteStatusText}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="620" />
            </Border>
            <Button Classes="link" Content="Go to error" Command="{Binding GoToErrorCommand}" IsVisible="{Binding HasErrorLocation}" />
          </StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding PasteWarnings}" Classes="muted" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Column="2" Text="Data array" Classes="muted" VerticalAlignment="Center" Margin="0,0,8,0" IsVisible="{Binding ShowPasteCandidates}" />
          <ComboBox Grid.Column="3" AutomationProperties.Name="Data array to convert" ItemsSource="{Binding PasteCandidates}" SelectedItem="{Binding SelectedPasteCandidate}" MinWidth="260" IsVisible="{Binding ShowPasteCandidates}" Margin="0,0,10,0">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="core:DataSourceCandidate"><TextBlock Text="{Binding Display}" /></DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Grid.Column="4" Classes="soft" Content="Options" Command="{Binding NavigateCommand}" CommandParameter="Settings" />
        </Grid>

        <!-- Live preview / Columns -->
        <Grid Grid.Row="2" RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Button Classes="tab" Classes.active="{Binding IsPreviewTab}" Content="Preview" Command="{Binding ShowPreviewTabCommand}" />
              <Button Classes="tab" Classes.active="{Binding IsColumnsTab}" Content="{Binding ColumnsTabTitle}" Command="{Binding ShowColumnsTabCommand}" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding PasteRowsText}" Classes="muted" VerticalAlignment="Center" Margin="12,0" IsVisible="{Binding IsPreviewTab}" />
            <TextBox Grid.Column="2" AutomationProperties.Name="Search preview rows" Text="{Binding PasteSearch}" Watermark="Search rows" Width="200" Margin="0,0,8,0" IsVisible="{Binding IsPreviewTab}" />
            <ComboBox Grid.Column="3" AutomationProperties.Name="Number of records in the preview" SelectedIndex="{Binding PasteRowsIndex}" Width="150" IsVisible="{Binding IsPreviewTab}" ToolTip.Tip="How many records to load into the preview">
              <ComboBoxItem Content="First 10 records" /><ComboBoxItem Content="First 50 records" /><ComboBoxItem Content="First 200 records" /><ComboBoxItem Content="First 1,000 records" />
            </ComboBox>
          </Grid>

          <Grid Grid.Row="1" IsVisible="{Binding IsPreviewTab}">
            <DataGrid x:Name="PastePreviewGrid" AutomationProperties.Name="Preview of the converted data" IsReadOnly="True" CanUserResizeColumns="True" CanUserSortColumns="False"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" IsVisible="{Binding PasteHasPreview}" />
            <Border Classes="card" IsVisible="{Binding !PasteHasPreview}">
              <TextBlock Classes="muted" Text="Records appear here as soon as the JSON is valid." HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </Grid>

          <Border Grid.Row="1" Classes="card" Padding="0" IsVisible="{Binding IsColumnsTab}">
            <Grid RowDefinitions="Auto,Auto,*">
              <Grid ColumnDefinitions="*,Auto,Auto" Margin="14,10,14,6">
                <TextBlock Text="{Binding RulesSummary}" Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="soft" Content="Include all" Command="{Binding IncludeAllColumnsCommand}" Margin="8,0,0,0" />
                <Button Grid.Column="2" Classes="soft" Content="Reset rules" Command="{Binding ResetRulesCommand}" Margin="8,0,0,0" />
              </Grid>
              <Grid Grid.Row="1" ColumnDefinitions="56,2*,80,64,2*,170,130" Margin="14,4,14,6">
                <TextBlock Text="Export" Classes="muted" FontSize="12" /><TextBlock Grid.Column="1" Text="Column (from the JSON)" Classes="muted" FontSize="12" />
                <TextBlock Grid.Column="2" Text="Type" Classes="muted" FontSize="12" /><TextBlock Grid.Column="3" Text="Filled" Classes="muted" FontSize="12" />
                <TextBlock Grid.Column="4" Text="Sample" Classes="muted" FontSize="12" /><TextBlock Grid.Column="5" Text="Rename to" Classes="muted" FontSize="12" />
                <TextBlock Grid.Column="6" Text="Mask" Classes="muted" FontSize="12" />
              </Grid>
              <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding ColumnRows}" Margin="14,0,14,10">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="m:ColumnRuleVm">
                      <Border Classes="row" Padding="0,4">
                        <Grid ColumnDefinitions="56,2*,80,64,2*,170,130">
                          <CheckBox AutomationProperties.Name="Include this column in the export" IsChecked="{Binding Include}" VerticalAlignment="Center" ToolTip.Tip="Include this column in the export" />
                          <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="{Binding Indent}" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                          <Border Grid.Column="2" Classes="badge" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="8,2"><TextBlock Text="{Binding Type}" FontSize="11" /></Border>
                          <TextBlock Grid.Column="3" Text="{Binding FilledText}" Classes="muted" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="4" Text="{Binding Sample}" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" ToolTip.Tip="{Binding Sample}" />
                          <TextBox Grid.Column="5" AutomationProperties.Name="Rename column to" Text="{Binding RenameTo}" Watermark="Keep name" Margin="0,0,8,0" />
                          <ComboBox Grid.Column="6" AutomationProperties.Name="Mask values in this column" SelectedIndex="{Binding MaskIndex}" HorizontalAlignment="Stretch" ToolTip.Tip="Redact replaces values with [REDACTED]; Hash replaces them with a one-way code (same value, same code)">
                            <ComboBoxItem Content="No mask" /><ComboBoxItem Content="Redact" /><ComboBoxItem Content="Hash" />
                          </ComboBox>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </Border>
        </Grid>

        <!-- Actions -->
        <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,14,0,0">
          <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <TextBlock Text="Have files instead?" Classes="muted" VerticalAlignment="Center" />
            <Button Classes="link" Content="Add files" Command="{Binding NavigateCommand}" CommandParameter="Files" />
          </StackPanel>
          <Grid Grid.Column="1" ColumnDefinitions="*,Auto" Margin="18,0" VerticalAlignment="Center" IsVisible="{Binding IsBusy}">
            <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="8" CornerRadius="4" Foreground="{DynamicResource SideBrush}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0">
              <TextBlock Classes="muted"><Run Text="{Binding StatusText}" /><Run Text="  " /><Run Text="{Binding ProgressText}" /></TextBlock>
              <Button Classes="soft" Content="Cancel" Command="{Binding CancelCommand}" />
            </StackPanel>
          </Grid>
          <Button Grid.Column="2" Classes="primary" Content="Download Excel" Command="{Binding DownloadExcelCommand}" Margin="0,0,10,0" />
          <Button Grid.Column="3" Classes="dark" Content="Download CSV" Command="{Binding DownloadCsvCommand}" />
        </Grid>
      </Grid>

      <!-- ===== Files page: list on top, preview of the selected file underneath ===== -->
      <Grid IsVisible="{Binding IsFilesPage}" Margin="24,16,24,78" RowDefinitions="Auto,Auto,*">

        <!-- Compact drop zone with totals -->
        <Border x:Name="DropZone" Classes="drop" Padding="16,12">
          <Grid ColumnDefinitions="*,Auto,Auto">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
              <Button Classes="primary" Content="Browse files" Command="{Binding AddFilesCommand}" Padding="18,8" />
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="or drop JSON, JSON Lines or TXT files here" FontWeight="SemiBold" />
                <TextBlock Text="Add as many as you like. Large files are streamed, not loaded into memory." Classes="muted" FontSize="12" />
              </StackPanel>
            </StackPanel>
            <TextBlock Grid.Column="1" Classes="muted" VerticalAlignment="Center" Margin="12,0" IsVisible="{Binding HasFiles}">
              <Run Text="{Binding FilesCountText}" /><Run Text=" files · " /><Run Text="{Binding RecordsTotalText}" /><Run Text=" records" />
            </TextBlock>
            <Button Grid.Column="2" Classes="soft" Content="Clear all" Command="{Binding ClearFilesCommand}" IsVisible="{Binding HasFiles}" />
          </Grid>
        </Border>

        <!-- File list (scrolls on its own so the preview always stays visible) -->
        <Border Grid.Row="1" Classes="card" Padding="8,6" Margin="0,12,0,0" IsVisible="{Binding HasFiles}">
          <ScrollViewer MaxHeight="210" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Files}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="m:FileItem">
                  <Border Classes="row" Classes.selected="{Binding IsSelected}" Tag="{Binding}" PointerPressed="OnFileRowPressed" Padding="12,7">
                    <Grid ColumnDefinitions="*,90,130,150,40">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource ErrBrush}" IsVisible="{Binding HasDetail}" TextWrapping="Wrap" FontSize="12" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding SizeText}" Classes="muted" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding RecordsText}" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <Border Grid.Column="3" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="8" Padding="10,3"
                              Background="{Binding Status, Converter={x:Static conv:StatusBrushConverter.Instance}, ConverterParameter=bg}">
                        <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{Binding Status, Converter={x:Static conv:StatusBrushConverter.Instance}, ConverterParameter=fg}" />
                      </Border>
                      <Button Grid.Column="4" Classes="icon" Content="✕" AutomationProperties.Name="Remove file" Tag="{Binding}" Click="OnRemoveFileClick" ToolTip.Tip="Remove file" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>

        <!-- Preview of the selected file -->
        <Grid Grid.Row="2" Margin="0,14,0,0" RowDefinitions="Auto,Auto,*" IsVisible="{Binding HasFiles}">
          <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
            <StackPanel VerticalAlignment="Center">
              <TextBlock Classes="h2"><Run Text="Preview: " /><Run Text="{Binding SelectedFile.Name, FallbackValue=''}" /></TextBlock>
              <TextBlock Classes="muted" Text="{Binding PreviewTotalsText}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <TextBlock Text="Data array" Classes="muted" VerticalAlignment="Center" IsVisible="{Binding ShowCandidates}" />
              <ComboBox AutomationProperties.Name="Data array to convert" ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedCandidate}" MinWidth="260" IsVisible="{Binding ShowCandidates}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="core:DataSourceCandidate"><TextBlock Text="{Binding Display}" /></DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button Classes="soft" Content="Refresh" Command="{Binding RefreshPreviewCommand}" />
            </StackPanel>
          </Grid>
          <StackPanel Grid.Row="1" Spacing="4">
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding PreviewBusy}" Height="4" Margin="0,0,0,6" />
            <TextBlock Text="{Binding PreviewMessage}" Foreground="{DynamicResource WarnBrush}" TextWrapping="Wrap" IsVisible="{Binding !HasPreview}" Margin="0,0,0,6" />
            <TextBlock Text="{Binding PreviewWarnings}" Foreground="{DynamicResource WarnBrush}" TextWrapping="Wrap" FontSize="12" />
          </StackPanel>
          <DataGrid x:Name="PreviewGrid" AutomationProperties.Name="Preview of the selected file" Grid.Row="2" IsReadOnly="True" CanUserResizeColumns="True" CanUserSortColumns="False"
                    HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasPreview}" />
          <Border Grid.Row="2" Classes="card" IsVisible="{Binding !HasPreview}">
            <TextBlock Classes="muted" Text="Click a file in the list to preview it here." HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </Grid>

        <Border Grid.Row="2" Classes="card" Margin="0,14,0,0" IsVisible="{Binding !HasFiles}">
          <TextBlock Classes="muted" Text="Add files to see their status and a preview here." HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </Grid>

      <!-- ===== Settings page ===== -->
      <ScrollViewer IsVisible="{Binding IsSettingsPage}" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" Spacing="16" MaxWidth="820" HorizontalAlignment="Left">
          <TextBlock Classes="h1" Text="Conversion settings" />
          <TextBlock Classes="muted" Text="These apply to the paste area and to files. Changes update the previews right away and are remembered." />
          <Border Classes="card">
            <StackPanel Spacing="10">
              <TextBlock Classes="h2" Text="Presets" />
              <TextBlock Classes="muted" TextWrapping="Wrap" Text="Save the current options and column rules (include, rename, mask) under a name, and reuse them for recurring feeds." />
              <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasPresets}">
                <ComboBox AutomationProperties.Name="Preset" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" Width="260" PlaceholderText="Choose a preset" />
                <Button Classes="primary" Content="Apply" Command="{Binding ApplyPresetCommand}" Padding="16,8" />
                <Button Classes="soft" Content="Delete" Command="{Binding DeletePresetCommand}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox AutomationProperties.Name="New preset name" Text="{Binding PresetName}" Watermark="Preset name, e.g. LIS results (masked)" Width="260" />
                <Button Classes="soft" Content="Save current as preset" Command="{Binding SavePresetCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel Spacing="12">
              <TextBlock Classes="h2" Text="Excel and CSV options" />
              <StackPanel Spacing="4"><TextBlock Classes="muted" Text="Sheet name (Excel)" /><TextBox AutomationProperties.Name="Excel sheet name" Text="{Binding SheetName}" Width="260" HorizontalAlignment="Left" MaxLength="31" /></StackPanel>
              <StackPanel Spacing="4"><TextBlock Classes="muted" Text="CSV delimiter" />
                <ComboBox AutomationProperties.Name="CSV delimiter" SelectedIndex="{Binding DelimiterIndex}" Width="260"><ComboBoxItem Content="Comma ( , )" /><ComboBoxItem Content="Semicolon ( ; )" /><ComboBoxItem Content="Tab" /></ComboBox></StackPanel>
              <StackPanel Spacing="4"><TextBlock Classes="muted" Text="CSV encoding" />
                <ComboBox AutomationProperties.Name="CSV encoding" SelectedIndex="{Binding CsvEncodingIndex}" Width="260"><ComboBoxItem Content="UTF-8 with BOM (best for Excel)" /><ComboBoxItem Content="UTF-8 without BOM" /><ComboBoxItem Content="UTF-16 (Unicode)" /></ComboBox></StackPanel>
              <StackPanel Spacing="4"><TextBlock Classes="muted" Text="Separator used when array values are combined into one cell" />
                <TextBox AutomationProperties.Name="Array separator" Text="{Binding ArraySeparator}" Width="120" HorizontalAlignment="Left" /></StackPanel>
              <CheckBox IsChecked="{Binding ProtectCsv}" Content="Protect CSV from formula injection (adds a ' before text starting with = + - @; plain dashes and phone numbers are left alone)" />
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="Recommended when the data comes from outside your organisation. Plain numbers are never changed, and Excel files are always safe." />
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel Spacing="12">
              <TextBlock Classes="h2" Text="Structure" />
              <CheckBox IsChecked="{Binding FlattenNested}" Content="Flatten nested objects into dotted columns (patient.demographics.age)" />
              <StackPanel Spacing="4"><TextBlock Classes="muted" Text="Arrays" />
                <ComboBox AutomationProperties.Name="How arrays are handled" SelectedIndex="{Binding ArrayModeIndex}" Width="380">
                  <ComboBoxItem Content="Combine values into one cell (separated by ;)" /><ComboBoxItem Content="Keep each array as JSON text" />
                  <ComboBoxItem Content="Expand arrays into separate rows" /><ComboBoxItem Content="Send object arrays to separate sheets" />
                </ComboBox>
                <TextBlock Classes="muted" Text="{Binding ArrayHint}" TextWrapping="Wrap" FontSize="12" /></StackPanel>
              <CheckBox IsChecked="{Binding ParseDates}" Content="Format ISO dates (2024-03-15, 2024-03-15T10:30:00) as Excel dates" />
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel Spacing="12">
              <TextBlock Classes="h2" Text="Columns and values" />
              <StackPanel Spacing="4"><TextBlock Classes="muted" Text="Column order" />
                <ComboBox AutomationProperties.Name="Column order" SelectedIndex="{Binding OrderIndex}" Width="380">
                  <ComboBoxItem Content="Smart (ID, Code, Name, Description, Date, Status, Type, rest)" /><ComboBoxItem Content="Alphabetical" />
                  <ComboBoxItem Content="Original JSON order" /><ComboBoxItem Content="Custom order" /></ComboBox></StackPanel>
              <StackPanel IsVisible="{Binding IsCustomOrder}" Spacing="4"><TextBlock Classes="muted" Text="Custom order: one column name per line. Unlisted columns follow in original order." />
                <TextBox AutomationProperties.Name="Custom column order, one name per line" Text="{Binding CustomOrderText}" AcceptsReturn="True" Height="110" Width="380" HorizontalAlignment="Left" /></StackPanel>
              <StackPanel Spacing="4"><TextBlock Classes="muted" Text="Null values" />
                <ComboBox AutomationProperties.Name="Null values" SelectedIndex="{Binding NullIndex}" Width="380"><ComboBoxItem Content="Leave blank" /><ComboBoxItem Content="Write the word null (missing fields stay blank)" /></ComboBox></StackPanel>
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel Spacing="10">
              <TextBlock Classes="h2" Text="Appearance" />
              <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="Theme" Classes="muted" VerticalAlignment="Center" />
                <ComboBox AutomationProperties.Name="Theme" SelectedIndex="{Binding ThemeIndex}" Width="200"><ComboBoxItem Content="Match system" /><ComboBoxItem Content="Light" /><ComboBoxItem Content="Dark" /></ComboBox></StackPanel>
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel Spacing="8">
              <TextBlock Classes="h2" Text="About" />
              <TextBlock><Run Text="JSON Converter Pro " /><Run Text="{Binding Version}" /></TextBlock>
              <TextBlock Classes="muted" TextWrapping="Wrap" Text="Converts JSON, JSON Lines and TXT files into Excel and CSV on your computer. Your data never leaves this device: there is no upload, account or telemetry." />
              <TextBlock Classes="muted" TextWrapping="Wrap" Text="Built with .NET, Avalonia UI, ClosedXML, SkiaSharp, CommunityToolkit.Mvvm and Microsoft.Extensions (all MIT licensed). See THIRD-PARTY-NOTICES.txt." />
              <Button Classes="soft" Content="Open log folder" Command="{Binding OpenLogFolderCommand}" HorizontalAlignment="Left" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- ===== History page ===== -->
      <Grid IsVisible="{Binding IsHistoryPage}" Margin="24" RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12"><TextBlock Classes="h1" Text="Recent conversions" /><Button Grid.Column="1" Classes="soft" Content="Clear history" Command="{Binding ClearHistoryCommand}" /></Grid>
        <ScrollViewer Grid.Row="1"><ItemsControl ItemsSource="{Binding History}"><ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="m:HistoryEntry"><Border Classes="card" Margin="0,0,0,8" Padding="14,10"><Grid ColumnDefinitions="*,Auto">
            <StackPanel><TextBlock Text="{Binding FileName}" FontWeight="SemiBold" /><TextBlock Text="{Binding Summary}" Classes="muted" TextWrapping="Wrap" /><TextBlock Text="{Binding Output}" Classes="muted" FontSize="12" /></StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding WhenText}" Classes="muted" />
          </Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
      </Grid>

      <!-- ===== Log page ===== -->
      <Grid IsVisible="{Binding IsLogPage}" Margin="24" RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,12"><StackPanel><TextBlock Classes="h1" Text="Error log" /><TextBlock Classes="muted" Text="Warnings and errors from this session. Full technical details are saved to the log files." /></StackPanel>
          <Button Grid.Column="1" Classes="soft" Content="Open log folder" Command="{Binding OpenLogFolderCommand}" Margin="0,0,8,0" /><Button Grid.Column="2" Classes="soft" Content="Clear" Command="{Binding ClearLogCommand}" /></Grid>
        <ScrollViewer Grid.Row="1"><ItemsControl ItemsSource="{Binding LogEntries}"><ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="m:LogEntry"><Border Classes="card" Margin="0,0,0,6" Padding="12,8"><Grid ColumnDefinitions="70,80,*">
            <TextBlock Text="{Binding WhenText}" Classes="muted" /><TextBlock Grid.Column="1" Text="{Binding Level}" FontWeight="SemiBold" /><TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap" />
          </Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
      </Grid>

      <!-- Files bar (batch convert) -->
      <Border VerticalAlignment="Bottom" IsVisible="{Binding ShowFilesBar}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,12">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <RadioButton GroupName="fmtB" Classes="seg" Content="Excel" IsChecked="{Binding IsExcel}" />
            <RadioButton GroupName="fmtB" Classes="seg" Content="CSV" IsChecked="{Binding IsCsv}" />
          </StackPanel>
          <Grid Grid.Column="1" ColumnDefinitions="*,Auto" Margin="18,0" VerticalAlignment="Center">
            <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="8" CornerRadius="4" Foreground="{DynamicResource SideBrush}" />
            <TextBlock Grid.Column="1" Margin="12,0,0,0" Classes="muted"><Run Text="{Binding StatusText}" /><Run Text="  " /><Run Text="{Binding ProgressText}" /></TextBlock>
          </Grid>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
            <Button Classes="soft" Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" />
            <Button Classes="primary" Content="Convert files" Command="{Binding ConvertCommand}" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
