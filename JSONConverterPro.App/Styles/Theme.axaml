<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <SolidColorBrush x:Key="SideBrush" Color="#0B3C49" />
    <SolidColorBrush x:Key="SideTextBrush" Color="#9CC7CF" />
    <SolidColorBrush x:Key="SideActiveBrush" Color="#15546A" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF6B5B" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#F25A49" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#DB4A3A" />
    <SolidColorBrush x:Key="PageBrush" Color="#F1F7F8" />
    <SolidColorBrush x:Key="InkBrush" Color="#0B2A33" />
    <SolidColorBrush x:Key="MutedBrush" Color="#6B8E96" />
    <SolidColorBrush x:Key="ChipBrush" Color="#DDEEF0" />
    <SolidColorBrush x:Key="LineBrush" Color="#C5DDE1" />
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="OkBrush" Color="#11704A" />
    <SolidColorBrush x:Key="OkBgBrush" Color="#DDF3E8" />
    <SolidColorBrush x:Key="WarnBrush" Color="#8A5A00" />
    <SolidColorBrush x:Key="WarnBgBrush" Color="#FFF1D6" />
    <SolidColorBrush x:Key="ErrBrush" Color="#B3261E" />
    <SolidColorBrush x:Key="ErrBgBrush" Color="#FDE8E6" />
  </Styles.Resources>

  <Style Selector="Window"><Setter Property="Background" Value="{DynamicResource PageBrush}" /><Setter Property="FontSize" Value="13" /></Style>
  <Style Selector="TextBlock"><Setter Property="Foreground" Value="{DynamicResource InkBrush}" /></Style>
  <Style Selector="TextBlock.h1"><Setter Property="FontSize" Value="22" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="TextBlock.h2"><Setter Property="FontSize" Value="15" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /></Style>
  <Style Selector="TextBlock.stat"><Setter Property="FontSize" Value="26" /><Setter Property="FontWeight" Value="SemiBold" /></Style>

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="16" />
  </Style>
  <Style Selector="Border.drop">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="26" />
  </Style>
  <Style Selector="Border.drop.hot"><Setter Property="Background" Value="#FFF0EE" /></Style>
  <Style Selector="Border.row"><Setter Property="CornerRadius" Value="10" /><Setter Property="Padding" Value="12,10" /><Setter Property="Margin" Value="0,2" /><Setter Property="Background" Value="Transparent" /></Style>
  <Style Selector="Border.row:pointerover"><Setter Property="Background" Value="#F1F7F8" /></Style>
  <Style Selector="Border.row.selected"><Setter Property="Background" Value="#DDEEF0" /></Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="22,10" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" /><Setter Property="Foreground" Value="White" /></Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource AccentPressedBrush}" /><Setter Property="Foreground" Value="White" /></Style>

  <Style Selector="Button.soft">
    <Setter Property="Background" Value="{DynamicResource ChipBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="Button.soft:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#CBE3E7" /><Setter Property="Foreground" Value="{DynamicResource InkBrush}" /></Style>

  <Style Selector="Button.icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#FDE8E6" /><Setter Property="Foreground" Value="#B3261E" /></Style>

  <Style Selector="Button.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource SideTextBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#114759" /><Setter Property="Foreground" Value="White" /></Style>
  <Style Selector="Button.nav.active /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource SideActiveBrush}" /><Setter Property="Foreground" Value="White" /></Style>

  <Style Selector="RadioButton.seg">
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>

  <Style Selector="DataGrid">
    <Setter Property="Background" Value="White" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="GridLinesVisibility" Value="All" />
    <Setter Property="HorizontalGridLinesBrush" Value="#E4F0F2" />
    <Setter Property="VerticalGridLinesBrush" Value="#E4F0F2" />
  </Style>
  <Style Selector="DataGridColumnHeader"><Setter Property="Background" Value="#DDEEF0" /><Setter Property="Foreground" Value="{DynamicResource InkBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="Border.banner"><Setter Property="Background" Value="{DynamicResource OkBgBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource OkBrush}" /></Style>
  <Style Selector="Border.banner.err"><Setter Property="Background" Value="{DynamicResource ErrBgBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource ErrBrush}" /></Style>
  <Style Selector="Border.banner.warn"><Setter Property="Background" Value="{DynamicResource WarnBgBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource WarnBrush}" /></Style>
</Styles>
